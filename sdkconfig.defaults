# Valores por defecto reconstruidos a partir del firmware original.
# El binario reporta: ESP32-P4 rev v1.3, 16 MB de flash, ESP-IDF v6.1,
# UART0 a 921600 baudios, pantalla 600x1024 vertical.

CONFIG_IDF_TARGET="esp32p4"

# --- Revision de chip ---
# La placa monta un ESP32-P4 rev v1.3. IDF 6.1 apunta por defecto a rev v3.1+
# y esptool rechaza el binario ("requires chip revision in range v3.1 - v3.99").
# Las revisiones <3.0 y >=3.0 son mutuamente excluyentes.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# Las revisiones <3.0 no admiten 400 MHz: el maximo es 360 MHz.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# --- Flash y particiones ---
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM (la placa lleva 32 MB hex) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# --- Consola (coincide con el binario: 921600) ---
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- Bootloader ---
# Con logs INFO el bootloader de IDF 6.1 ocupa 0x6140 y no entra en los
# 0x6000 bytes disponibles antes de la tabla de particiones (0x8000).
# Sin logs entra de sobra y conserva el layout original del firmware.
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

# --- FreeRTOS ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- LVGL 8 ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_MEM_SIZE_KILOBYTES=128
# Montserrat solo como fallback de simbolos (como el original)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_USE_FLEX=y
CONFIG_LV_USE_GRID=y

# --- Cache: necesario para PPA / DSI en P4 ---
CONFIG_CACHE_L2_CACHE_256KB=y

# --- Rendimiento: -O2 (el valor por defecto -Og es de depuracion y frena LVGL) ---
CONFIG_COMPILER_OPTIMIZATION_PERF=y
